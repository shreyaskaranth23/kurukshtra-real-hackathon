app.post('/api/run',async(req,res)=>{
 const mode=process.env.MODE==='live'?'live':'demo';
 if(mode==='live'&&liveConfigured&&req.get('x-scout-token')!==liveToken)return res.status(401).json({error:'Live run token is missing or incorrect. Add the operator token to authorize this task.'});
 const parsed=validRun.safeParse(req.body);if(!parsed.success)return res.status(400).json({error:parsed.error.issues[0]?.message||'Invalid task'});
 const {task,budget}=parsed.data;const plan=planResearchTask(task);if(!plan)return res.status(400).json({error:'This prototype supports a Books to Scrape research task with price conversion and a Hindi summary. Use or adapt the sample prompt.'});const registry=agentRows();const selectedAgents=plan.categories.map(category=>registry.filter(a=>a.category===category).sort((x,y)=>(y.successRate??0)-(x.successRate??0)||x.price-y.price||(x.medianMs??Infinity)-(y.medianMs??Infinity))[0]).filter(Boolean);const selectedPrice=selectedAgents.reduce((sum,a)=>sum+a.price,0);const estimate=selectedPrice;const a=selectedAgents;
 const runInfo={selected:a.map(x=>({id:x.id,name:x.name,price:x.price,category:x.category,reason:`Chosen by comparing recorded success rate, quote, and response time in the ${x.category.toLowerCase()} category; ${x.price} USDC per request.`})),estimate,mode};
 if(estimate>budget)return res.status(402).json({error:`Estimated cost $${estimate.toFixed(3)} exceeds your $${budget.toFixed(3)} budget. No services were called.`,...runInfo});
 if(mode==='live'&&!liveConfigured)return res.status(503).json({error:'Live x402 is not configured. Add three Base Sepolia payout addresses and a dedicated testnet buyer key; no payments were sent.',...runInfo});
 if(mode==='live'){const today=new Date().toISOString().slice(0,10);const prior:any=db.prepare('SELECT COALESCE(SUM(amount),0) spend FROM calls WHERE tx_hash IS NOT NULL AND substr(created_at,1,10)=?').get(today);if(Number(prior.spend)+estimate>maxDailySpend)return res.status(429).json({error:`Daily testnet spend cap reached. Remaining today: $${Math.max(0,maxDailySpend-Number(prior.spend)).toFixed(3)} USDC. No service requests were sent.` ,...runInfo});}
 const started=new Date().toISOString();const runId=Number(db.prepare('INSERT INTO runs(task,budget,spent,mode,status,created_at) VALUES(?,?,?,?,?,?)').run(task,budget,0,mode,'running',started).lastInsertRowid);
 const events:any[]=[];const log=(stage:string,message:string)=>events.push({stage,message,at:new Date().toISOString()});
 try{
  log('received','Task received by Scout');log('planning',`Identified service categories: ${plan.categories.join(', ')}; selected ${plan.count} books from pages 1–${plan.pages}`);log('registry',`Searched ${registry.length} registered agents and selected the lowest quoted seller in each required category`);log('budget',`Budget check passed — estimated ${estimate.toFixed(3)} USDC; ${mode==='demo'?'demo mode makes no payment':'live mode will settle each call separately'}`);
  let paidFetch:typeof fetch|undefined;let paymentClient:x402HTTPClient|undefined;
  if(mode==='live'){const account=privateKeyToAccount(process.env.EVM_PRIVATE_KEY as `0x${string}`);const xclient=new x402Client().register('eip155:84532',new ExactEvmClientScheme(account));paidFetch=wrapFetchWithPayment(fetch,xclient);paymentClient=new x402HTTPClient(xclient);}
  const paidPost=async<T>(endpoint:string,agentId:string,body:unknown,quote:number)=>{const t=Date.now();let r:Response;try{r=await (paidFetch||fetch)(`http://127.0.0.1:${port}/api/paid/${endpoint}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});}catch(e){priceCalls.run(runId,agentId,'failed',Date.now()-t,0,null,new Date().toISOString());throw e;}const settlement=paymentClient?.getPaymentSettleResponse(name=>r.headers.get(name));const txHash=settlement?.success?settlement.transaction:null;if(!r.ok){priceCalls.run(runId,agentId,'failed',Date.now()-t,txHash?quote:0,txHash,new Date().toISOString());throw new Error(`Seller ${endpoint} request failed (${r.status}): ${await r.text()}`);}const value=await r.json() as T;if(mode==='live'&&!settlement?.success){priceCalls.run(runId,agentId,'failed',Date.now()-t,0,null,new Date().toISOString());throw new Error(`x402 settlement not confirmed for ${endpoint}; the service response was not recorded as paid`);}priceCalls.run(runId,agentId,'success',Date.now()-t,mode==='live'?quote:0,txHash,new Date().toISOString());return value;};
  const zBooks=z.array(z.object({title:z.string(),price:z.string(),rating:z.string(),description:z.string()}));
