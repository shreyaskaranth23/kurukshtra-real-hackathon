const decodeHtml=(value:string)=>value.replace(/&#(\d+);/g,(_m,n)=>String.fromCodePoint(Number(n))).replace(/&#x([\da-f]+);/gi,(_m,n)=>String.fromCodePoint(parseInt(n,16))).replace(/&amp;/g,'&').replace(/&quot;/g,'"').replace(/&apos;|&#39;/g,"'").replace(/&nbsp;/g,' ');
async function scrapeBooks(pages=4,count=3){
 const books:any[]=[];
 for(let p=1;p<=Math.min(4,Math.max(1,pages));p++){
  const pageUrl=`${BASE}${p}.html`;const r=await fetch(pageUrl,{headers:{'User-Agent':'AgentXchange research prototype (public demo)'}}); if(!r.ok) throw new Error(`Books demo source returned ${r.status}`); const html=await r.text();
  const items=html.split('<article class="product_pod">').slice(1);
  for(const item of items){const title=decodeHtml((item.match(/title="([^"]+)"/)||[])[1]||''); const price=(item.match(/class="price_color">([^<]+)/)||[])[1]||''; const rating=(item.match(/star-rating ([A-Za-z]+)/)||[])[1]||'';const href=(item.match(/<h3><a href="([^"]+)"/)||[])[1]; if(title&&href) books.push({title,price,rating,url:new URL(href,pageUrl).toString()});}
 }
 const chosen=books.filter(b=>b.rating==='Five').sort((x,y)=>parseFloat(x.price.replace('£',''))-parseFloat(y.price.replace('£',''))).slice(0,Math.min(3,Math.max(1,count)));
 return Promise.all(chosen.map(async book=>{const url=new URL(book.url);if(url.hostname!=='books.toscrape.com')throw new Error('Scraper blocked a link outside the approved Books to Scrape host');const response=await fetch(url,{headers:{'User-Agent':'AgentXchange research prototype (public demo)'}});if(!response.ok)throw new Error(`Book details returned ${response.status}`);const html=await response.text();const marker=html.indexOf('id="product_description"');const paragraphStart=marker<0?-1:html.indexOf('<p>',marker);const paragraphEnd=paragraphStart<0?-1:html.indexOf('</p>',paragraphStart);let raw=paragraphStart>=0&&paragraphEnd>paragraphStart?html.slice(paragraphStart+3,paragraphEnd):'';const firstSentence=raw.match(/^(.{80,240}?[.!?])(?:\s|[A-Z])/);if(firstSentence){const duplicate=raw.indexOf(firstSentence[1],firstSentence[1].length);if(duplicate>0&&duplicate<260)raw=raw.slice(0,duplicate)+raw.slice(duplicate+firstSentence[1].length);}const description=decodeHtml(raw.replace(/<[^>]*>/g,' ').replace(/\s+/g,' ').trim())||'No description published.';return {title:book.title,price:book.price,rating:book.rating,description};}));
}
function planResearchTask(task:string){const value=task.toLowerCase();const categories:string[]=[];if(/book|scrap|catalog|books\.toscrape/.test(value))categories.push('Scraping');if(/convert|currency|exchange|inr|rate|price/.test(value))categories.push('Data');if(/summar|hindi|translate/.test(value))categories.push('Inference');if(categories.length!==3)return null;const pagesMatch=value.match(/pages?\s*(\d+)\s*(?:to|-)\s*(\d+)/);const pages=pagesMatch?Math.max(1,Math.min(4,Number(pagesMatch[2]))):4;const countMatch=value.match(/\b(three|3|two|2|one|1)\s+(?:cheapest|books|results|items)\b/);const count=countMatch?({three:3,'3':3,two:2,'2':2,one:1,'1':1} as Record<string,number>)[countMatch[1]]:3;return {categories,pages,count};}
async function getRate(){ const r=await fetch('https://open.er-api.com/v6/latest/USD'); if(!r.ok) throw new Error('Exchange rate source unavailable'); const data:any=await r.json(); return {rate:data.rates?.INR,gbpToInr:data.rates?.INR/data.rates?.GBP,date:data.time_last_update_utc,source:'open.er-api.com'}; }
async function summarize(text:string){
 if(process.env.OPENAI_API_KEY){const r=await fetch('https://api.openai.com/v1/chat/completions',{method:'POST',headers:{Authorization:`Bearer ${process.env.OPENAI_API_KEY}`,'Content-Type':'application/json'},body:JSON.stringify({model:process.env.OPENAI_MODEL||'gpt-4o-mini',messages:[{role:'system',content:'Write a concise Hindi summary. Do not invent facts. Mention this is a summary of book titles, prices and ratings.'},{role:'user',content:text}],temperature:0.3})});if(!r.ok)throw new Error('Configured summarization provider failed');const d:any=await r.json();return {summary:d.choices?.[0]?.message?.content||'',provider:process.env.OPENAI_MODEL||'OpenAI model'};}
 const entries=text.split('\n').map(line=>{const [titlePart,...descriptionParts]=line.split('Description:');return {book:titlePart.trim(),description:(descriptionParts.join('Description:').trim().split(/(?<=[.!?])\s/)[0]||'').slice(0,220)};});const excerpts=entries.map(e=>`${e.book}: “${e.description}”`).join(' ');return {summary:`तीन चुनी हुई पाँच-सितारा पुस्तकों के विवरणों से मुख्य अंश: ${excerpts}। ये मूल विवरणों के अंश हैं; यह निर्धारित डेमो सारांश है, AI मॉडल का उत्तर नहीं।`,provider:'Deterministic extractive demo fallback (no AI inference)'};
}
