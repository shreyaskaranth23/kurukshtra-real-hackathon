  if(!selected.length) throw new Error('No five-star books found in the selected pages');log('scrape',`Atlas Scraper returned ${selected.length} five-star books with descriptions from Books to Scrape`);if(mode==='demo')priceCalls.run(runId,'atlas-scraper','success',scrapMs,0,null,new Date().toISOString());
