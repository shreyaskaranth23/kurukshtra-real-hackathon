 <section className="panel timeline-panel"><div className="panel-heading"><div><h3>Execution timeline</h3><span>{run?'Latest Scout run':'Your run will appear here'}</span></div><span className={`timeline-status ${running?'working':run?'done':''}`}><i/>{running?'IN PROGRESS':run?'COMPLETED':'STANDING BY'}</span></div><div className="timeline">{[['received','Task received'],['planning','Planning services'],['registry','Searching registry'],['budget','Checking budget'],['scrape','Calling scraper'],['data','Retrieving currency data'],['inference','Generating Hindi summary'],['validation','Validating results'],['complete','Completing report']].map(([id,label],i)=><div key={id} className={`timeline-step ${run?.events.some(e=>e.stage===id)?'step-done':''} ${running&&i<active?'step-done':''} ${running&&i===active?'step-active':''}`}><div className="step-marker">{run?.events.some(e=>e.stage===id)?<Check size={11}/>:running&&i===active?<span className="step-pulse"/>:null}</div><span>{label}</span>{run?.events.find(e=>e.stage===id)&&<small>{new Date(run.events.find(e=>e.stage===id)!.at).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</small>}</div>)}</div><div className="timeline-foot"><span className="tiny-lock"><LockKeyhole size={11}/></span> Payment safety checks are applied before any live request.</div></section></div>
 {run&&<section className="report-panel"><div className="report-head"><div><div className="eyebrow">SCOUT RESEARCH REPORT · RUN #{run.id}</div><h2>Research complete <BadgeCheck size={20}/></h2><p>Scout coordinated {run.selected.length} specialists and validated their responses.</p></div><span className="demo-banner"><ShieldCheck size={15}/>{run.paid?'x402 payment settled':'DEMO · NO PAYMENT SENT'}</span></div><div className="report-grid"><div className="report-result"><div className="report-label"><BookOpen size={14}/> FINDINGS</div><div className="book-list">{run.books.map((b,i)=><div className="book-row" key={i}><div className="book-rank">0{i+1}</div><div><b>{b.title}</b><span>{b.rating} rated · {b.price}</span><small className="book-description">{b.description}</small></div><strong>₹{b.priceINR}</strong></div>)}</div><div className="fx-note"><ArrowUpRight size={13}/> USD/INR {run.exchangeRate.rate.toFixed(2)} · GBP/INR {run.exchangeRate.gbpToInr.toFixed(2)} · {run.exchangeRate.source}</div><div className="summary-box"><div className="report-label"><MessageSquareText size={14}/> HINDI SUMMARY</div><p>{run.summary}</p><span className="provider-tag"><Sparkles size={12}/>{run.summarizer}</span></div></div><div className="hired-panel"><div className="report-label"><Bot size={14}/> AGENTS HIRED</div>{run.selected.map(a=><div className="hired-agent" key={a.id}><div className="hired-check"><Check size={12}/></div><div><b>{a.name}</b><span>{a.reason}</span></div><strong>${a.price.toFixed(3)}</strong></div>)}<div className="report-total"><span>Estimated total</span><b>${run.estimate.toFixed(3)} <small>USDC</small></b></div><div className="payment-receipt"><LockKeyhole size={14}/><span>{run.paymentNote}</span></div></div></div></section>}
 </div>}
function ActivityPage({activity,stats}:{activity:any[];stats:Stats}){return <div className="content"><PageHeading eyebrow="WORKSPACE RECORDS" title={<>A clear view of <span className="gradient-text">every run.</span></>} subtitle="Activity is recorded locally. Only confirmed x402 settlement receipts count as on-chain payments." action={<span className="testnet-stamp"><span className="online-dot"/> TESTNET MODE</span>}/><div className="activity-stats"><Metric title="Task runs" value={String(stats.runs)} note="Persisted task records" icon={Zap} tone="violet"/><Metric title="Service calls" value={String(stats.calls)} note="Demo or configured calls" icon={Activity} tone="cyan"/><Metric title="Confirmed payments" value={String(stats.settledPayments)} note="Settlement receipts only" icon={ShieldCheck} tone="green"/><Metric title="Recorded spend" value={`$${stats.recordedSpend.toFixed(3)}`} note="Successful paid calls" icon={Wallet} tone="blue"/></div><div className="panel records-panel"><div className="panel-heading"><div><h3>Service call records</h3><span>Stored locally in the SQLite database</span></div><span className="records-count">{activity.length} records shown</span></div>{activity.length===0?<div className="empty-records"><div className="empty-icon"><Activity size={20}/></div><b>Nothing has run yet</b><span>Scout service call records will show up here.</span></div>:<div className="table-scroll"><table><thead><tr><th>SELLER AGENT</th><th>STATUS</th><th>RESPONSE TIME</th><th>PAYMENT</th><th>RECORDED</th></tr></thead><tbody>{activity.map(x=><tr key={x.id}><td><div className="table-agent"><div className="table-avatar"><Bot size={14}/></div><b>{x.agent_name}</b></div></td><td><span className="table-success"><Check size={12}/>{x.status}</span></td><td>{x.latency_ms} ms</td><td>{x.tx_hash?<a href={`https://sepolia.basescan.org/tx/${x.tx_hash}`} target="_blank" rel="noreferrer">{short(x.tx_hash)}</a>:'—'} <span className="muted">· no payment</span></td><td>{new Date(x.created_at).toLocaleString()}</td></tr>)}</tbody></table></div>}</div><div className="market-note"><ShieldCheck size={16}/><span><b>Transparent records.</b> Demo calls are logged for debugging but have a $0 recorded spend. A payment is only counted when a settlement receipt is stored.</span></div></div>}
function AgentModal({agent:a,close,tryAgent}:{agent:Agent;close:()=>void;tryAgent:()=>void}){return <div className="modal-scrim" onClick={close}><div className="agent-modal" onClick={e=>e.stopPropagation()}><button className="modal-close" onClick={close}><X size={18}/></button><div className="modal-icon"><Bot size={23}/></div><span className="category-chip">{a.category} service</span><h2>{a.name}</h2><p>{a.description}</p><div className="modal-price"><b>${a.price.toFixed(3)}</b><span>USDC per request</span></div><div className="modal-meta"><div><span>Network</span><b>Base Sepolia</b></div><div><span>Availability</span><b className="available-text"><i/> Available</b></div><div><span>Success rate</span><b>{a.successRate===null?'No history yet':`${a.successRate}%`}</b></div><div><span>Median response</span><b>{a.medianMs===null?'No history yet':`${a.medianMs} ms`}</b></div><div><span>Completed requests</span><b>{a.completed}</b></div><div><span>Seller payment address</span><b className="modal-address">{a.payTo||'Not configured'}</b></div></div><div className="schema-pair"><Schema title="INPUT SCHEMA" data={a.inputSchema}/><Schema title="OUTPUT SCHEMA" data={a.outputSchema}/></div><div className={`modal-x402 ${a.x402Configured?'is-configured':''}`}><span className="status-dot"/>{a.x402Configured?'x402 payment route configured':'x402 payment route needs seller payout configuration'}</div><button className="primary-button modal-try" onClick={tryAgent}><Play size={14} fill="currentColor"/> Try with Scout <ArrowRight size={14}/></button><small className="modal-disclaimer">TESTNET MODE · Registry prices do not mean payment occurred.</small></div></div>}
function Schema({title,data}:{title:string;data:Record<string,string>}){return <div className="schema-box"><div>{title}</div>{Object.entries(data).map(([k,v])=><span key={k}><code>{k}</code><i>{v}</i></span>)}</div>}
createRoot(document.getElementById('root')!).render(<React.StrictMode><App/></React.StrictMode>);
