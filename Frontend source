function App(){
 const [page,setPage]=useState<'overview'|'marketplace'|'scout'|'activity'>('overview');const [agents,setAgents]=useState<Agent[]>([]);const [stats,setStats]=useState<Stats>({runs:0,calls:0,settledPayments:0,recordedSpend:0});const [activity,setActivity]=useState<any[]>([]);const [mode,setMode]=useState('demo');const [liveToken,setLiveToken]=useState('');const [search,setSearch]=useState('');const [category,setCategory]=useState('All services');const [maxPrice,setMaxPrice]=useState('');const [sort,setSort]=useState('recommended');const [budget,setBudget]=useState('0.02');const [task,setTask]=useState('Find the three cheapest five-star books from pages 1 to 4 of books.toscrape.com, convert their prices to INR, and summarize their descriptions in Hindi.');const [running,setRunning]=useState(false);const [progress,setProgress]=useState(0);const [run,setRun]=useState<Run|null>(null);const [error,setError]=useState('');const [selected,setSelected]=useState<Agent|null>(null);const [mobileOpen,setMobileOpen]=useState(false);const [toast,setToast]=useState('');
 const refresh=async()=>{try{const [a,s,h,y]=await Promise.all([fetch('/api/agents').then(r=>r.json()),fetch('/api/stats').then(r=>r.json()),fetch('/api/health').then(r=>r.json()),fetch('/api/activity').then(r=>r.json())]);setAgents(a);setStats(s);setMode(h.mode);setActivity(y);}catch{}};
 useEffect(()=>{refresh();},[]);
 const filtered=useMemo(()=>{let a=agents.filter(x=>(category==='All services'||x.category===category)&&(!maxPrice||x.price<=Number(maxPrice))&&`${x.name} ${x.description}`.toLowerCase().includes(search.toLowerCase()));if(sort==='price')a.sort((x,y)=>x.price-y.price);if(sort==='success')a.sort((x,y)=>(y.successRate??0)-(x.successRate??0));if(sort==='latency')a.sort((x,y)=>(x.medianMs??Infinity)-(y.medianMs??Infinity));return a;},[agents,category,search,maxPrice,sort]);
 const notify=(s:string)=>{setToast(s);setTimeout(()=>setToast(''),2400);};
 async function launch(){if(running)return;setError('');setRun(null);setProgress(0);setRunning(true);let phase=0;const ticker=setInterval(()=>{phase=Math.min(phase+1,8);setProgress(phase);},750);try{const headers:Record<string,string>={'Content-Type':'application/json'};if(mode==='live')headers['x-scout-token']=liveToken;const r=await fetch('/api/run',{method:'POST',headers,body:JSON.stringify({task,budget:Number(budget)})});const data=await r.json();if(!r.ok)throw new Error(data.error||'Scout could not complete this run.');setRun(data);await refresh();}catch(e){setError(e instanceof Error?e.message:'Request failed');await refresh();}finally{clearInterval(ticker);setRunning(false);}}
 const nav=[['overview','Overview',LayoutDashboard],['marketplace','Marketplace',Compass],['scout','Scout workspace',Bot],['activity','Activity',Activity]] as const;
 return <div className="app-shell">
  <aside className={`sidebar ${mobileOpen?'open':''}`}><div className="brand"><div className="brand-icon"><Network size={20}/></div><span>agent<span className="brand-accent">x</span>change</span><button className="close-mobile" onClick={()=>setMobileOpen(false)}><X size={18}/></button></div>
   <div className="side-label">WORKSPACE</div><nav>{nav.map(([id,label,Icon])=><button key={id} className={`nav-item ${page===id?'active':''}`} onClick={()=>{setPage(id);setMobileOpen(false)}}><Icon size={17}/><span>{label}</span>{id==='marketplace'&&<span className="nav-count">{agents.length}</span>}</button>)}</nav>
  <div className="side-label side-label-bottom">DEVELOPER</div><a className="nav-item" href="https://github.com/x402-foundation/x402/tree/main/typescript" target="_blank" rel="noreferrer"><Code2 size={17}/><span>SDK reference</span><ExternalLink size={13} className="nav-ext"/></a><a className="nav-item" href="https://docs.x402.org/" target="_blank" rel="noreferrer"><BookOpen size={17}/><span>Documentation</span><ExternalLink size={13} className="nav-ext"/></a>
   <div className="sidebar-bottom"><div className="network-card"><div className="network-head"><span className="online-dot"/> TESTNET MODE</div><div className="network-name"><span className="base-mark">◒</span> Base Sepolia</div><div className="network-note">{mode==='live'?'x402 payments configured':'Demo mode · no payments sent'}</div><a href="https://sepolia.basescan.org" target="_blank" rel="noreferrer">Open explorer <ExternalLink size={12}/></a></div><div className="user-chip"><div className="avatar">S</div><div><b>Scout Agent</b><span>Buyer workspace</span></div><ChevronDown size={15}/></div></div>
  </aside>
  {mobileOpen&&<button className="mobile-scrim" onClick={()=>setMobileOpen(false)} aria-label="Close navigation"/>}
  <main className="main"><header className="topbar"><button className="mobile-menu" onClick={()=>setMobileOpen(true)}><Menu size={19}/></button><div className="breadcrumb"><span>Workspace</span><span className="crumb-slash">/</span><b>{nav.find(n=>n[0]===page)?.[1]}</b></div><div className="top-actions"><div className="top-network"><span className="online-dot"/> Base Sepolia <ChevronDown size={13}/></div><button className="wallet-button" onClick={()=>notify(mode==='live'?'Buyer wallet is configured server-side':'Connect a testnet buyer wallet in server environment settings')}><Wallet size={15}/><span>{mode==='live'?'Wallet configured':'Connect wallet'}</span></button><div className="top-avatar">S</div></div></header>
   {page==='overview'&&<Overview stats={stats} agents={agents} activity={activity} mode={mode} go={setPage} onPick={setSelected}/>}
   {page==='marketplace'&&<Marketplace agents={filtered} search={search} setSearch={setSearch} category={category} setCategory={setCategory} maxPrice={maxPrice} setMaxPrice={setMaxPrice} sort={sort} setSort={setSort} onPick={setSelected}/>}
   {page==='scout'&&<Scout task={task} setTask={setTask} budget={budget} setBudget={setBudget} run={run} running={running} progress={progress} error={error} launch={launch} agents={agents} mode={mode} liveToken={liveToken} setLiveToken={setLiveToken}/>}
   {page==='activity'&&<ActivityPage activity={activity} stats={stats}/>}
   <footer className="footer"><span>AgentXchange <span className="muted">· autonomous agent commerce</span></span><span><span className="online-dot"/> TESTNET ONLY <span className="footer-sep">·</span> <a href="https://www.x402.org/" target="_blank" rel="noreferrer">x402 protocol <ExternalLink size={11}/></a></span></footer>
  </main>
  {selected&&<AgentModal agent={selected} close={()=>setSelected(null)} tryAgent={()=>{setSelected(null);setPage('scout');notify(`Scout can route a task through ${selected.name}`)}}/>}{toast&&<div className="toast"><Check size={15}/>{toast}</div>}
 </div>
}
function PageHeading({eyebrow,title,subtitle,action}:{eyebrow:string;title:React.ReactNode;subtitle:string;action?:React.ReactNode}){return <div className="page-heading"><div><div className="eyebrow">{eyebrow}</div><h1>{title}</h1><p>{subtitle}</p></div>{action}</div>}
function Overview({stats,agents,activity,mode,go,onPick}:{stats:Stats;agents:Agent[];activity:any[];mode:string;go:(p:any)=>void;onPick:(a:Agent)=>void}){
 const icons=[Database,Globe2,Sparkles];return <div className="content"><PageHeading eyebrow="MONDAY, OCTOBER 16 · YOUR WORKSPACE" title={<>The agent economy, <span className="gradient-text">in motion.</span></>} subtitle="Delegate specialist work to trusted agents, one verified request at a time." action={<button className="primary-button" onClick={()=>go('scout')}><Plus size={16}/> New task <ArrowRight size={15}/></button>}/>
  <div className="hero-panel"><div className="hero-orbit orbit-one"/><div className="hero-orbit orbit-two"/><div className="hero-content"><div className="hero-pill"><span className="pulse-dot"/> AUTONOMOUS MARKETPLACE FOR AI AGENTS</div><h2>Discover. Delegate.<br/><span>Pay Per Call.</span></h2><p>Scout finds the right specialist, checks the budget, and brings back validated results. Live payments stay on Base Sepolia; demo runs send none.</p><button className="hero-button" onClick={()=>go('marketplace')}>Explore the marketplace <ArrowRight size={15}/></button></div><div className="hero-flow"><div className="flow-node buyer"><div className="flow-icon"><Bot size={21}/></div><b>Scout</b><span>Buyer agent</span></div><div className="flow-link"><i/><i/><i/></div><div className="flow-node seller"><div className="flow-icon"><Sparkles size={20}/></div><b>Specialists</b><span>{agents.length} registered agents</span></div><div className="flow-link"><i/><i/><i/></div><div className="flow-node verified"><div className="flow-icon"><BadgeCheck size={20}/></div><b>Verified result</b><span>Schema checked</span></div><div className="flow-caption"><span className="tiny-lock"><LockKeyhole size={11}/></span> x402 HTTP payments <span className="flow-dot">·</span> Base Sepolia</div></div></div>
  <div className="section-title-row"><div><h3>Network at a glance</h3><span>Real records from this workspace</span></div><button className="text-button" onClick={()=>go('activity')}>View activity <ArrowRight size={14}/></button></div>
  <div className="metrics-grid"><Metric title="Registered agents" value={String(agents.length).padStart(2,'0')} note="Available in registry" icon={Bot} tone="violet"/><Metric title="Task runs" value={String(stats.runs).padStart(2,'0')} note="Persisted in this workspace" icon={Zap} tone="cyan"/><Metric title="Service calls" value={String(stats.calls).padStart(2,'0')} note="Demo calls are not payments" icon={Activity} tone="blue"/><Metric title="Settled on-chain" value={String(stats.settledPayments).padStart(2,'0')} note="Confirmed payment records" icon={ShieldCheck} tone="green"/></div>
  <div className="overview-columns"><section className="panel agents-panel"><div className="panel-heading"><div><h3>Popular agents</h3><span>Choose a specialist to inspect</span></div><button className="icon-button" onClick={()=>go('marketplace')}><ArrowUpRight size={17}/></button></div><div className="agent-list">{agents.slice(0,3).map((a,i)=>{const Icon=icons[i%icons.length];return <button className="agent-row" key={a.id} onClick={()=>onPick(a)}><div className={`agent-avatar av-${i}`}><Icon size={18}/></div><div className="agent-row-main"><b>{a.name}</b><span>{a.category} <span className="middot">·</span> {a.description}</span></div><div className="agent-price">${fmt(a.price)} <span>/ call</span></div><ArrowRight size={14} className="row-arrow"/></button>})}</div><button className="panel-link" onClick={()=>go('marketplace')}>Browse all agents <ArrowRight size={14}/></button></section>
   <section className="panel activity-panel"><div className="panel-heading"><div><h3>Recent activity</h3><span>Latest records for this workspace</span></div><button className="icon-button" onClick={()=>go('activity')}><ArrowUpRight size={17}/></button></div>{activity.length===0?<div className="empty-activity"><div className="empty-icon"><Activity size={20}/></div><b>No activity yet</b><span>Run a Scout task to see recorded service calls here.</span><button onClick={()=>go('scout')}>Start a task <ArrowRight size={13}/></button></div>:<div className="activity-mini">{activity.slice(0,4).map(x=><div className="mini-row" key={x.id}><div className="status-check"><Check size={12}/></div><div><b>{x.agent_name}</b><span>{x.status==='success'?'Completed service call':'Failed'} · {x.latency_ms}ms</span></div><time>{new Date(x.created_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}</time></div>)}</div>}</section></div>
  <div className="bottom-info"><div><div className="info-icon"><ShieldCheck size={18}/></div><span><b>Safe by design</b><small>Dedicated testnet wallets. Budget checks before any paid request.</small></span></div><span className="mode-chip"><span className="online-dot"/>{mode==='live'?'LIVE x402 · Base Sepolia':'DEMO MODE · NO PAYMENTS'}</span></div>
 </div>}
function Metric({title,value,note,icon:Icon,tone}:{title:string;value:string;note:string;icon:any;tone:string}){return <div className="metric-card"><div className="metric-top"><span>{title}</span><div className={`metric-icon ${tone}`}><Icon size={16}/></div></div><div className="metric-value">{value}</div><div className="metric-note"><span className="metric-trend">•</span> {note}</div></div>}
function Marketplace({agents,search,setSearch,category,setCategory,maxPrice,setMaxPrice,sort,setSort,onPick}:{agents:Agent[];search:string;setSearch:(s:string)=>void;category:string;setCategory:(s:string)=>void;maxPrice:string;setMaxPrice:(s:string)=>void;sort:string;setSort:(s:string)=>void;onPick:(a:Agent)=>void}){return <div className="content"><PageHeading eyebrow="DISCOVER SPECIALISTS" title={<>Meet your next <span className="gradient-text">teammate.</span></>} subtitle="Browse registered agents by service, inspect their schemas, and compare per-call pricing." action={<span className="testnet-stamp"><span className="online-dot"/> TESTNET MODE</span>}/><div className="market-tools"><label className="search-box"><Search size={16}/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Search agents or services..."/><kbd>⌘ K</kbd></label><label className="select-wrap"><Filter size={14}/><select value={category} onChange={e=>setCategory(e.target.value)}><option>All services</option><option>Data</option><option>Inference</option><option>Scraping</option></select><ChevronDown size={14}/></label><label className="select-wrap sort-select"><BarChart3 size={14}/><select value={sort} onChange={e=>setSort(e.target.value)}><option value="recommended">Recommended</option><option value="price">Lowest price</option><option value="success">Success rate</option><option value="latency">Fastest response</option></select><ChevronDown size={14}/></label><label className="price-filter"><span>MAX PRICE</span><div><span>$</span><input type="number" min="0" step="0.001" placeholder="Any" value={maxPrice} onChange={e=>setMaxPrice(e.target.value)}/><small>USDC</small></div></label></div><div className="market-results"><span><b>{agents.length}</b> registered services</span><span>All prices in testnet USDC</span></div><div className="market-grid">{agents.map((a,i)=><AgentCard key={a.id} agent={a} idx={i} onClick={()=>onPick(a)}/>)}{!agents.length&&<div className="no-results"><Search size={20}/><b>No matching agents</b><span>Try a different name or category.</span></div>}</div><div className="market-note"><ShieldCheck size={16}/><span><b>Testnet only.</b> Registry prices are quotes. No transfer occurs unless a separately configured x402 buyer wallet completes payment on Base Sepolia.</span></div></div>}
function AgentCard({agent:a,idx,onClick}:{agent:Agent;idx:number;onClick:()=>void}){const Icons=[Database,Globe2,Sparkles];const Icon=Icons[idx%Icons.length];return <article className="market-card"><div className="card-top"><div className={`agent-avatar large av-${idx%3}`}><Icon size={20}/></div><span className="available"><i/> Available</span></div><div className="card-title"><h3>{a.name}</h3><span className="category-chip">{a.category}</span></div><p className="card-description">{a.description}</p><div className="card-price"><b>${fmt(a.price)}</b><span>USDC <i>/ request</i></span><span className="network-chip">Base Sepolia</span></div><div className="card-stats"><div><span>Success rate</span><b>{a.successRate===null?'—':`${a.successRate}%`}</b></div><div><span>Median response</span><b>{a.medianMs===null?'—':`${a.medianMs} ms`}</b></div><div><span>Completed</span><b>{a.completed}</b></div></div><div className="payto-line"><span>Seller address</span><code>{short(a.payTo)}</code></div><div className="card-footer"><span className={`x402-status ${a.x402Configured?'configured':''}`}><span className="status-dot"/>{a.x402Configured?'x402 configured':'x402 not configured'}</span><button className="outline-button" onClick={onClick}>View details <ArrowRight size={13}/></button></div></article>;}
function Scout({task,setTask,budget,setBudget,run,running,progress,error,launch,agents,mode,liveToken,setLiveToken}:{task:string;setTask:(x:string)=>void;budget:string;setBudget:(x:string)=>void;run:Run|null;running:boolean;progress:number;error:string;launch:()=>void;agents:Agent[];mode:string;liveToken:string;setLiveToken:(x:string)=>void}){const stages=['received','planning','registry','budget','scrape','data','inference','validation','complete'];const active=running?progress:run?9:0;return <div className="content"><PageHeading eyebrow="BUYER AGENT · AUTONOMOUS RESEARCH" title={<>Meet <span className="gradient-text">Scout.</span></>} subtitle="Describe your goal. Scout plans the work, checks the budget, and coordinates specialist agents." action={<span className="testnet-stamp"><span className="online-dot"/> TESTNET MODE</span>}/><div className="scout-layout"><section className="panel scout-form"><div className="scout-intro"><div className="scout-mark"><Bot size={22}/></div><div><b>New research task</b><span>Scout will build a plan from registered services.</span></div><span className="scout-live"><i/> READY</span></div><label className="field-label">WHAT SHOULD SCOUT DO?</label><textarea value={task} onChange={e=>setTask(e.target.value)} rows={5} placeholder="Describe your task in plain language..."/><div className="suggested-task"><Sparkles size={13}/><span>Try the sample research task</span><button onClick={()=>setTask('Find the three cheapest five-star books from pages 1 to 4 of books.toscrape.com, convert their prices to INR, and summarize their descriptions in Hindi.')}>Use example</button></div><div className="budget-row"><div><label className="field-label">MAXIMUM BUDGET</label><div className="budget-input"><span>$</span><input value={budget} onChange={e=>setBudget(e.target.value)} type="number" min="0.001" step="0.001"/><span>USDC</span></div></div><div className="budget-estimate"><span>Estimated service quotes</span><b>{agents.reduce((v,a)=>v+a.price,0)